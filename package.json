{
  "name": "vonsim8",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:no-assembler": "turbo run test --filter=!@vonsim/assembler",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:optional": "cd e2e && pnpm test:e2e:optional",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "audit": "pnpm audit --audit-level moderate",
    "dev": "pnpm --dir app run dev",
    "docs:dev": "pnpm --dir docs run dev",
    "build": "pnpm --dir packages/scripts run build",
    "preview": "pnpm --dir app run preview --outDir=../dist",
    "deploy": "gh-pages -d app/dist"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.5.2",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "gh-pages": "^6.3.0",
    "prettier": "~3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.11.13",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.7.2"
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": "^6.4.4",
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.9",
      "serialize-javascript": "^7.1.3",
      "satori>fflate": "^0.7.5",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3"
    }
  }
}
