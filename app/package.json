  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint --ignore-path .gitignore . --fix",
    "lint:fix": "tsc --noEmit && eslint --ignore-path .gitignore . --fix",
    "format": "prettier --write . && pnpm lint",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest --run src/test/integration/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "audit": "pnpm audit --audit-level moderate",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"for (const d of ['dist', 'coverage', 'test-results', 'playwright-report']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "verify-tour": "node scripts/verify-tour-elements.js",
